region                     = "<OCI region>"
compartment_id             = "<compartment OCID>"
subnet_id                  = "<public subnet OCID>"
gateway_name               = "TraficInfoAPIGW"
state_bucket_name          = "<private state bucket name>"
function_objects_policy_id = "<existing functions Object Storage policy OCID>"

# Set the actual token only in the private file or TF_VAR_jawg_access_token.
jawg_access_token = "<Jawg access token>"

# Optional; these are the dev defaults.
jawg_style               = "jawg-light"
tile_requests_per_second = 50
tile_allowed_origins     = ["*"]
