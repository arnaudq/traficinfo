/.idea
target

# Webapp dependencies, build output and local configuration
/webapp/node_modules/
/webapp/dist/
/webapp/.cache/
/webapp/**/*.local

# Infrastructure working directories, state, plans and local settings
/infra/**/.terraform/
/infra/**/terraform.tfstate*
/infra/**/*.tfplan
/infra/**/crash.log
/infra/**/crash.*.log
/infra/**/*.tfvars
/infra/**/*.tfvars.json
/infra/**/*.tfbackend
