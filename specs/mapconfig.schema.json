{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TraficInfo map configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "geoJsonBaseUrl",
    "maps",
    "boundaries"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "geoJsonBaseUrl": {
      "type": "string",
      "pattern": "^https?://[^?#]+$",
      "description": "Public GeoJSON object directory, without query or fragment."
    },
    "maps": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "description",
          "center",
          "zoom",
          "dataSources",
          "boundaryId"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
            "description": "Must match the key in maps; independent of data source IDs."
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "description": "Map introduction, followed by shared usage instructions."
          },
          "center": {
            "type": "array",
            "prefixItems": [
              {
                "type": "number",
                "minimum": -180,
                "maximum": 180
              },
              {
                "type": "number",
                "minimum": -90,
                "maximum": 90
              }
            ],
            "minItems": 2,
            "maxItems": 2
          },
          "zoom": {
            "type": "integer",
            "minimum": 0,
            "maximum": 24
          },
          "dataSources": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "types"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
                },
                "types": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "enum": [
                      "VEHICULES",
                      "BICYCLES"
                    ]
                  },
                  "minItems": 1,
                  "uniqueItems": true
                }
              }
            },
            "minItems": 1,
            "uniqueItems": true,
            "description": "Ordered sources from dsconfig.json with an ordered list of populations; one remote layer per selected type. Source IDs must be distinct."
          },
          "uri": {
            "type": "string",
            "pattern": "^https?://",
            "description": "Existing published map URL; omit for unpublished maps."
          },
          "properties": {
            "type": "object",
            "description": "uMap property overrides, recursively merged; arrays replace defaults."
          },
          "layerProperties": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
            },
            "additionalProperties": {
              "type": "object",
              "description": "uMap property overrides, recursively merged; arrays replace defaults."
            },
            "description": "Optional layer property overrides keyed by a source ID included in dataSources."
          },
          "boundaryId": {
            "type": "string",
            "minLength": 1,
            "description": "Reference to a boundary in the boundaries registry."
          }
        }
      }
    },
    "boundaries": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "type": "string",
        "minLength": 1
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "boundaryId",
          "type",
          "name",
          "geoJsonPath"
        ],
        "properties": {
          "boundaryId": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "enum": [
              "region",
              "city"
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "parentId": {
            "type": "string",
            "minLength": 1
          },
          "geoJsonPath": {
            "type": "string",
            "pattern": "^boundaries/(?!.*(?:^|/)\\.\\.(?:/|$))[^?#]+\\.geojson$"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "type": {
                  "const": "city"
                }
              }
            },
            "then": {
              "required": [
                "parentId"
              ]
            },
            "else": {
              "not": {
                "required": [
                  "parentId"
                ]
              }
            }
          }
        ]
      }
    }
  }
}
